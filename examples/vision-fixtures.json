        "rationale": "Red wraps around the HSV hue boundary. A circularity filter removes thin color artifacts.",
        "operations": [
          {
            "id": "preset0_0",
            "kind": "resize",
            "params": {
              "max_side": 1280
            }
          },
          {
            "id": "preset0_1",
            "kind": "gaussian_blur",
            "params": {
              "kernel": 3
            }
          },
          {
            "id": "preset0_2",
            "kind": "hsv_mask",
            "params": {
              "hue_low": 170,
              "hue_high": 7,
              "saturation_low": 120,
              "saturation_high": 255,
              "value_low": 65,
              "value_high": 255
            }
          },
          {
            "id": "preset0_3",
            "kind": "morph_open",
            "params": {
              "kernel": 3
            }
          },
          {
            "id": "preset0_4",
            "kind": "morph_close",
            "params": {
              "kernel": 3
            }
          },
          {
            "id": "preset0_5",
            "kind": "contours",
            "params": {
              "min_area": 0.004,
              "max_area": 0.85,
              "min_circularity": 0.65,
              "min_solidity": 0.0,
              "min_aspect": 1.0,
              "max_aspect": 100.0,
              "reject_border": true
            }
          }
        ]
      },
      {
        "id": "preset1",
        "name": "Dark connected regions",
        "parent_id": "preset0",
        "fork_after": "preset0_1",
        "rationale": "CImg groups the dark foreground. Inspect missed candy boundaries and merged regions.",
        "operations": [
          {
            "id": "preset1_0",
            "kind": "grayscale",
            "params": {}
          },
          {
            "id": "preset1_1",
            "kind": "otsu",
            "params": {}
          },
          {
            "id": "preset1_2",
            "kind": "invert",
            "params": {}
          },
          {
            "id": "preset1_3",
            "kind": "morph_open",
            "params": {
              "kernel": 3
            }
          },
          {
            "id": "preset1_4",
            "kind": "morph_close",
            "params": {
              "kernel": 3
            }
          },
          {
            "id": "regions",
            "kind": "cimg_components",
            "params": {
              "connectivity": "8",
              "min_pixels": 300,
              "max_pixels": 4200000,
              "reject_border": true
            }
          }
        ]
      },
      {
        "id": "confirmed",
        "name": "Red + region agreement",
        "parent_id": "preset0",
        "fork_after": "preset0_5",
        "rationale": "Overlap confirmation preserves primary measurements. This deliberately imperfect support misses one true red candy: compare the final mask with the primary detector.",
        "operations": [
          {
            "id": "agreement",
            "kind": "confirm",
            "params": {
              "pipeline_ids": "preset1",
              "min_support": 1,
              "iou": 0.3,
              "match_text": false
            }
          }
        ]
      }
    ]
