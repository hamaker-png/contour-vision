  {
    "id": "circle-shape-confirmation",
    "title": "Circles with rectangle confusers · 2D",
    "filename": "circle-shape-confirmation.png",
    "path": "/examples/circle-shape-confirmation.png",
    "source": "",
    "credit": "Generated analytic development image · known geometry",
    "description": "Find the two filled circles. Ignore both rectangular outlines. Measure the fitted circle diameter.",
    "context": "Constructed development example based on an observed rectangle false positive. Circle voting returns one extra object; contour confirmation removes it here. Agreement is not a probability of correctness or a promise for new shapes.",
    "labeled": true,
    "boxes": [
      {
        "x": 0.634375,
        "y": 0.15833333333333333,
        "width": 0.109375,
        "height": 0.14583333333333334
      },
      {
        "x": 0.234375,
        "y": 0.7083333333333334,
        "width": 0.096875,
        "height": 0.12916666666666668
      }
    ],
    "workbench_only": true,
    "pipelines": [
      {
        "id": "main",
        "name": "Circle voting",
        "parent_id": null,
        "fork_after": null,
        "rationale": "Circle voting also proposes a circle inside the small rectangle. Inspect the fitted disk.",
        "operations": [
          {
            "id": "grayscale",
            "kind": "grayscale",
            "params": {}
          },
          {
            "id": "hough_circles",
            "kind": "hough_circles",
            "params": {
              "min_distance": 45.0,
              "edge_threshold": 100.0,
              "votes": 10.0,
              "min_radius": 10,
              "max_radius": 28
            }
          }
        ]
      },
      {
        "id": "closed_shape",
        "name": "Closed circular contour",
        "parent_id": "main",
        "fork_after": "grayscale",
        "rationale": "Edges and a circularity filter supply a separate shape check.",
        "operations": [
          {
            "id": "edge_support",
            "kind": "canny",
            "params": {
              "low": 50,
              "high": 150
            }
          },
          {
            "id": "shape_support",
            "kind": "contours",
            "params": {
              "min_area": 0.001,
              "max_area": 0.1,
              "min_circularity": 0.84,
              "min_solidity": 0.0,
              "min_aspect": 1.0,
              "max_aspect": 1.25,
              "reject_border": true
            }
          }
        ]
      },
      {
        "id": "confirmed",
        "name": "Circles with shape confirmation",
        "parent_id": "main",
        "fork_after": "hough_circles",
        "rationale": "Keep fitted circles whose boxes overlap a sufficiently round contour. Primary dimensions are preserved.",
        "operations": [
          {
            "id": "agreement",
            "kind": "confirm",
            "params": {
              "pipeline_ids": "closed_shape",
              "min_support": 1,
              "iou": 0.5,
              "match_text": false
            }
          }
        ]
      }
    ]
